# Secrets — never commit. Real keys live here only.
.env
.env.*
!.env.example
.keys/
*.key
test-ledger/
scratch/

# In a git worktree these are symlinks to the owner's disk, not directories, and a trailing
# slash matches directories only — so the slash-less forms are what keep `git add -A` from
# committing an absolute local path as a file.
node_modules/
node_modules
/node_modules
server/node_modules
.expo/
dist/
web-build/
out/
cache/
broadcast/
artifacts/
typechain/
*.log
.DS_Store
*.tsbuildinfo
subgraph/generated/
subgraph/build/
subgraph/node_modules/
subgraph/node_modules
contracts/out/
contracts/cache/

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli

# A captured session token for the screenshot harness. The two lines above were glued together,
# so this pattern read as part of the expo-cli marker and ignored nothing.
tools/.auth.json
contracts/lib/swap-vm/node_modules/
contracts/lib/swap-vm/node_modules

# The owner's design reference video — a 9.5 MB input, not source.
/reference-ui.mp4

# Key material in any of its usual containers.
*.pem
*.p8
*.p12
*.jks
*.keystore
.env.fork

# Native projects are generated by `npx expo prebuild` from app.json and the installed modules —
# they are build output, not source. Committing them means every dependency change arrives as a
# thousand-file diff, and the checked-in copy silently stops matching the config that produced it.
/android
/ios

# The demo's intermediate. The .mp4 and .gif are committed; the source webm is 2MB of duplicate.
docs/demo/*.webm

# Web build output. `npm run build:base` regenerates it and verifies the artifact.
dist-base/
dist/
dist-web/
