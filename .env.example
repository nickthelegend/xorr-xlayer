# Copy to .env and fill in. Never commit .env — it is gitignored, keep it that way.
#
# Every variable below is read by code in this repo. Verified with:
#   grep -rhoE 'process\.env\.[A-Z_]+' server/src src app | sort -u

# ── Auth ─────────────────────────────────────────────────────────────────────
# From dashboard.privy.io. The executor REFUSES to start without these: an
# unauthenticated trading server is the one configuration that must never exist.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
EXPO_PUBLIC_PRIVY_APP_ID=
# Server-side Privy controls: the authorization key that signs policy writes, and the key quorum
# that owns the policy. Without them the policy screens report "not configured" rather than guess.
PRIVY_AUTHORIZATION_KEY=
PRIVY_KEY_QUORUM_ID=
# The operator's bearer token for agent-key administration. A long random value; never in a client.
OPERATOR_TOKEN=

# ── Venues and data ──────────────────────────────────────────────────────────
ONEINCH_API_KEY=
# Optional. Only the bot's voice degrades without it, never a number.
OPENROUTER_API_KEY=
# Optional. Overrides the default free model for the bot's voice.
XORR_MODEL=

# ── The Graph ────────────────────────────────────────────────────────────────
# Deploy key from Subgraph Studio. Used by `graph auth`, not by the server.
GRAPH_DEPLOY_KEY=
# The delegation index — permissions, spends, daily rollups.
SUBGRAPH_URL=
EXPO_PUBLIC_SUBGRAPH_URL=
# The Aqua venue index. Without it every route falls to the aggregator and says so.
AQUA_SUBGRAPH_URL=
# Only needed for gateway-hosted subgraphs, not Studio.
GRAPH_API_KEY=

# ── Chain ────────────────────────────────────────────────────────────────────
# localnet | base-fork | base-sepolia | base
#   base-sepolia  real chain, real grants, CANNOT fill (no 1inch there)
#   base-fork     anvil forking Base MAINNET — the only place everything is real at once
#   base          requires ALLOW_MAINNET=yes as a deliberate decision
XORR_CHAIN=base-sepolia
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_RPC=https://mainnet.base.org
LOCAL_RPC=http://127.0.0.1:8545
FORK_RPC=http://127.0.0.1:8545
# Guardrail. Mainnet needs a reviewed decision, never a default.
ALLOW_MAINNET=

# ── Contracts ────────────────────────────────────────────────────────────────
DELEGATION_ADDRESS=
# Which chain the APP signs on. Must match XORR_CHAIN, or the user's transactions go to a
# different network from the one the executor settles on. `base-fork` also needs the RPC.
EXPO_PUBLIC_XORR_CHAIN=base-sepolia
# EXPO_PUBLIC_CHAIN_RPC=http://127.0.0.1:8545

# XorrAquaBook. Aqua is Base-mainnet-only, so this is unset on a testnet.
AQUA_BOOK_ADDRESS=
# XorrSwapVMBook, the other maker book. Same story: fork or mainnet only.
SWAPVM_BOOK_ADDRESS=
# XorrAuditAnchor — where the audit trail's head hash is published.
ANCHOR_ADDRESS=
# The delegation contract the subgraph at SUBGRAPH_URL indexes. When it is not the contract this
# executor trades through, the Graph checks stand aside instead of reporting another deployment.
SUBGRAPH_DELEGATION_ADDRESS=
# Overrides for the official protocol contracts. Leave unset to use 1inch's own deployments.
AQUA_ADDRESS=
SWAPVM_ADDRESS=
# The bot's signing key. Generated into XORR_KEY_DIR when absent. A file is
# adequate for a local fork and NOT adequate beyond one — see docs/SECURITY.md.
DELEGATE_PRIVATE_KEY=
XORR_KEY_DIR=
# Pays the small test-ETH drip a brand-new wallet needs to sign its first permission. Testnet only,
# and never the delegate key: a faucet paid from the bot's key spends the gas every trade needs.
# Unset means no drip, and the trail says so.
FAUCET_PRIVATE_KEY=

# ── Executor ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/xorr_eth
PORT=8788
EXPO_PUBLIC_API_URL=http://localhost:8788
# Set to `off` to start without the scheduler loop.
SCHEDULER=
SCHEDULER_TICK_MS=30000
# Minimum spacing between outbound requests to one upstream host.
HTTP_MIN_SPACING_MS=1100
# Retries for a busy upstream (429 / 5xx / timeout), with exponential backoff from this base.
HTTP_MAX_ATTEMPTS=5
HTTP_BACKOFF_BASE_MS=800
# Per-IP request limits: every route, and the routes that spend upstream quota.
RATE_LIMIT_GENERAL=300
RATE_LIMIT_UPSTREAM=60
RATE_LIMIT_WINDOW_MS=60000
# How often the audit trail's head is anchored on chain.
ANCHOR_EVERY_MS=3600000
# How far back the venue and event scans look, in blocks.
AQUA_LOOKBACK_BLOCKS=9000
SWAPVM_LOOKBACK_BLOCKS=9000
LOG_WINDOW_BLOCKS=1800
# SEC EDGAR requires a contact in the User-Agent of every request.
SEC_USER_AGENT=

# ── Tests ────────────────────────────────────────────────────────────────────
# Pin the fork block so a demo is reproducible: forge test --fork-block-number
FORK_BLOCK=

# ── Origins allowed to call the executor ─────────────────────────────────────
# Comma-separated. Unset means `*`, which is what a local dev setup wants and
# what a deployment should never ship: any page the user has open can then make
# a same-credentials request. It matters less here than it looks — auth is a
# bearer token, not a cookie, so a hostile page cannot borrow the session — but
# CORS is the cheapest control in the stack and there is no reason to leave it
# open. Expo web serves from 8081 unless that port is taken; a device build
# sends no Origin at all and is unaffected either way.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082

# ── MongoDB copy of the executor's database ──────────────────────────────────
# Postgres stays the executor's database. With both of these set, the executor
# also copies every table into this Atlas database on a schedule, verified row
# by row (server/src/db/mongo-mirror.ts, docs/RUNBOOK.md §10). The destination
# has no default, so a local executor sharing this file never copies a laptop
# over a deployment's copy; `npm run mirror:mongo` (server) copies the local
# database into xorr_local when run by hand.
MONGODB_URI=
MONGO_MIRROR_DB=
# Minutes between copies; 0 turns the schedule off.
MONGO_MIRROR_INTERVAL_MIN=30
