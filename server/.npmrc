# Same reason as the root `.npmrc`: this lockfile was resolved with legacy peer deps.
#
# Without it, npm 10 (the Node 22 runner's npm) rejects `npm ci` outright: "lock file's
# utf-8-validate@6.0.6 does not satisfy utf-8-validate@5.0.10" — an optional peer that strict
# resolution adds and the lockfile never recorded. npm 11 and any machine whose user npmrc sets this
# installed it fine, which is why it only failed on a clean runner.
legacy-peer-deps=true
