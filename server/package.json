{
  "name": "xorr-eth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.live.test.ts\"",
    "test:live": "LIVE=1 vitest run live.test",
    "setup:fork": "tsx src/fork-bootstrap.ts",
    "rebuild:fork": "tsx src/fork-bootstrap.ts && set -a && . \"./${FORK_ENV_FILE:-.env.fork}\" && set +a && tsx src/fork-grant.ts",
    "reconcile:orphans": "tsx src/fork/reconcile-orphans.ts",
    "mirror:mongo": "tsx src/db/mirror-to-mongo.ts",
    "prove:fork": "tsx src/prove-xlayer.ts",
    "prove:testnet": "tsx src/prove-testnet.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@privy-io/server-auth": "^1.32.5",
    "dotenv": "^17.2.3",
    "hono": "^4.10.7",
    "jose": "^6.2.12",
    "mongodb": "^6.21.0",
    "pg": "^8.16.3",
    "viem": "^2.56.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
