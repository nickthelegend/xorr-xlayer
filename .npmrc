# The lockfile was resolved with legacy peer deps, and installs have to resolve it the same way.
#
# @privy-io/react-auth pulls @solana/kit (through @wagmi/connectors -> @base-org/account ->
# @coinbase/cdp-sdk), which declares `peerOptional typescript ^5`; the app is on TypeScript 6. With
# strict peer resolution `npm ci` refuses the tree with ERESOLVE. It only ever installed on machines
# whose user-level npmrc already set this, which is how CI failed on a clean runner while every
# local install passed. Reproduced with npm 10.9.9 and no inherited config: exit 1 without this
# file, exit 0 with it.
legacy-peer-deps=true
